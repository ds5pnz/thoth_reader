{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: explicit app commands + event listen only. No fs/http/shell/sql/dialog/opener permissions for the frontend.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-library-list",
    "allow-import-pick",
    "allow-document-import",
    "allow-document-open",
    "allow-document-close",
    "allow-document-delete",
    "allow-library-thumb-begin",
    "allow-library-cover-set",
    "allow-sections-list",
    "allow-blocks-get",
    "allow-extraction-begin",
    "allow-blocks-commit-batch",
    "allow-extraction-finalize-section",
    "allow-open-external",
    "allow-reader-save-position",
    "allow-bookmark-put",
    "allow-bookmark-delete",
    "allow-bookmark-list",
    "allow-window-fullscreen",
    "allow-annotation-put",
    "allow-annotation-delete",
    "allow-annotation-list",
    "allow-search-query",
    "allow-settings-get",
    "allow-settings-patch",
    "allow-translation-save-edit",
    "allow-translation-apply-revision",
    "allow-translation-history",
    "allow-block-set-preference",
    "allow-reader-set-viewport",
    "allow-translation-request",
    "allow-translation-cancel",
    "allow-translate-selection",
    "allow-translation-batch-start",
    "allow-translation-batch-cancel",
    "allow-translation-batch-status",
    "allow-export-translation",
    "allow-export-pdf-begin",
    "allow-export-pdf-page",
    "allow-export-pdf-end",
    "allow-reader-set-mode",
    "allow-translation-pause",
    "allow-reader-switch-profile",
    "allow-reader-get-snapshot",
    "allow-provider-save",
    "allow-provider-list",
    "allow-provider-probe",
    "allow-provider-new-cache-epoch",
    "allow-profile-create",
    "allow-cache-invalidate",
    "allow-storage-usage",
    "allow-chatgpt-sign-in",
    "allow-chatgpt-sign-in-cancel",
    "allow-chatgpt-sign-out",
    "allow-codex-status",
    "allow-codex-connect",
    "allow-debug-selftest-files",
    "allow-debug-log",
    "allow-debug-snapshot"
  ]
}
