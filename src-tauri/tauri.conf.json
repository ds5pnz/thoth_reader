{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thoth Reader",
  "version": "1.0.0",
  "identifier": "app.thoth.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Thoth Reader",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: thoth-doc: http://thoth-doc.localhost",
        "font-src": "'self' thoth-doc: http://thoth-doc.localhost",
        "connect-src": "ipc: http://ipc.localhost thoth-doc: http://thoth-doc.localhost",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
